{
  "expo": {
    "name": "frontend",
    "slug": "frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "frontend",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.emergent.smoothui.ciqrep"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "package": "com.emergent.smoothui.ciqrep"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#000000"
        }
      ],
      "expo-font",
      ["expo-camera", { "cameraPermission": "Allow DawaiSathi to scan family QR codes.", "recordAudioAndroid": false }],
      "expo-image",
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow DawaiSathi to choose a medicine identification photo.",
          "cameraPermission": "Allow DawaiSathi to take a medicine identification photo.",
          "microphonePermission": "Allow DawaiSathi to record a voice note."
        }
      ],
      ["expo-audio", { "microphonePermission": "Allow DawaiSathi to record a voice note.", "enableBackgroundRecording": false, "enableBackgroundPlayback": false }],
      "expo-secure-store",
      "expo-web-browser",
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
